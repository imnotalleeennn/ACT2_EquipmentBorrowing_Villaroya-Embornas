<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:EquipmentBorrowing.Desktop.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="700"
        x:Class="EquipmentBorrowing.Desktop.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="Campus Equipment Borrowing System"
        Width="1150" Height="720"
        MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen">

    <Grid RowDefinitions="Auto,*">
        <!-- TOP APP BAR -->
        <Border Grid.Row="0" Background="#0F172A" Padding="20,14">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <Border Background="#3B82F6" CornerRadius="8" Width="36" Height="36">
                        <TextBlock Text="🛠️" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="CISC Equipment Borrowing System" FontWeight="Bold" FontSize="16" Foreground="#F8FAFC" />
                    </StackPanel>
                </StackPanel>

                <Border Grid.Column="2" Background="#1E293B" CornerRadius="6" Padding="10,6" VerticalAlignment="Center">
                    <TextBlock Text="In-Memory Session Active" FontSize="11" FontWeight="SemiBold" Foreground="#38BDF8" />
                </Border>
            </Grid>
        </Border>

        <!-- MAIN BODY (Sidebar + Content View) -->
        <Grid Grid.Row="1" ColumnDefinitions="240,*">
            <!-- SIDEBAR NAVIGATION -->
            <Border Grid.Column="0" Background="#1E293B" Padding="14,20">
                <Grid RowDefinitions="Auto,*,Auto">
                    <!-- Nav Section Header -->
                    <TextBlock Grid.Row="0" Text="NAVIGATION" FontWeight="Bold" FontSize="11" Foreground="#64748B" Margin="10,0,0,14" LetterSpacing="1" />

                    <!-- Nav Buttons -->
                    <StackPanel Grid.Row="1" Spacing="8">
                        <!-- Equipment Nav Button -->
                        <Button Command="{Binding NavigateToEquipmentCommand}"
                                HorizontalAlignment="Stretch" Padding="14,12" CornerRadius="8">
                            <Button.Styles>
                                <Style Selector="Button">
                                    <Setter Property="Background" Value="#334155" />
                                    <Setter Property="Foreground" Value="#F8FAFC" />
                                </Style>
                                <Style Selector="Button:pointerover">
                                    <Setter Property="Background" Value="#2563EB" />
                                </Style>
                            </Button.Styles>
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <TextBlock Text="📦" FontSize="16" VerticalAlignment="Center" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Equipment" FontWeight="SemiBold" FontSize="14" />
                                    <TextBlock Text="Browse &amp; borrow" FontSize="11" Foreground="#CBD5E1" />
                                </StackPanel>
                            </StackPanel>
                        </Button>

                        <!-- Borrowings Nav Button -->
                        <Button Command="{Binding NavigateToBorrowingsCommand}"
                                HorizontalAlignment="Stretch" Padding="14,12" CornerRadius="8">
                            <Button.Styles>
                                <Style Selector="Button">
                                    <Setter Property="Background" Value="#334155" />
                                    <Setter Property="Foreground" Value="#F8FAFC" />
                                </Style>
                                <Style Selector="Button:pointerover">
                                    <Setter Property="Background" Value="#059669" />
                                </Style>
                            </Button.Styles>
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <TextBlock Text="📋" FontSize="16" VerticalAlignment="Center" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Active Borrowings" FontWeight="SemiBold" FontSize="14" />
                                    <TextBlock Text="View &amp; return loans" FontSize="11" Foreground="#CBD5E1" />
                                </StackPanel>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Architecture Info Card at Sidebar Bottom -->
                    <Border Grid.Row="2" Background="#0F172A" BorderBrush="#334155" BorderThickness="1" CornerRadius="8" Padding="12">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Architecture Stack" FontWeight="SemiBold" FontSize="11" Foreground="#94A3B8" />
                            <TextBlock Text="• View (Avalonia XAML)" FontSize="10" Foreground="#64748B" />
                            <TextBlock Text="• ViewModel (CommunityToolkit)" FontSize="10" Foreground="#64748B" />
                            <TextBlock Text="• Application (Clean Use Cases)" FontSize="10" Foreground="#64748B" />
                            <TextBlock Text="• Domain &amp; Repositories" FontSize="10" Foreground="#64748B" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- MAIN CONTENT AREA -->
            <Border Grid.Column="1" Background="#F8FAFC">
                <ContentControl Content="{Binding CurrentPage}" />
            </Border>
        </Grid>
    </Grid>
</Window>
